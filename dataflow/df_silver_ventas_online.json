{
  "name": "df_silver_ventas_online",
  "properties": {
    "folder": {
      "name": "silver"
    },
    "type": "MappingDataFlow",
    "typeProperties": {
      "sources": [
        {
          "dataset": {
            "referenceName": "bronze_ventas_online",
            "type": "DatasetReference"
          },
          "name": "source1"
        }
      ],
      "sinks": [
        {
          "dataset": {
            "referenceName": "silver_ventas_online",
            "type": "DatasetReference"
          },
          "name": "sink1"
        }
      ],
      "transformations": [
        {
          "name": "filter1"
        },
        {
          "name": "derivedColumn1"
        }
      ],
      "scriptLines": [
        "source(output(",
        "          order_id as string,",
        "          timestamp as string,",
        "          product as string,",
        "          qty as string,",
        "          unit_price as string,",
        "          customer_name as string,",
        "          customer_email as string,",
        "          customer_city as string,",
        "          payment_method as string,",
        "          status as string,",
        "          shipping_cost as string",
        "     ),",
        "     allowSchemaDrift: true,",
        "     validateSchema: false,",
        "     isolationLevel: 'READ_UNCOMMITTED',",
        "     query: 'SELECT order_id, timestamp, product, qty, unit_price, customer_name, customer_email, customer_city, payment_method, status, shipping_cost FROM bronze.ventas_online_raw',",
        "     format: 'query') ~> source1",
        "source1 filter(!isNull(order_id) && length(trim(order_id)) > 0) ~> filter1",
        "filter1 derive(id_venta = trim(order_id),",
        "          fecha = coalesce(toDate(timestamp,'yyyy-MM-dd'), toDate(left(timestamp,10),'yyyy-MM-dd'), toDate(timestamp,'dd-MMM-yyyy'), toDate(timestamp,'MMMM dd, yyyy'), toDate(timestamp,'yyyy/MM/dd'), toDate(timestamp,'dd/MM/yyyy'), toDate(replace(timestamp,' de ',' '),'dd MMMM yyyy'), toDate(timestamp,'MM-dd-yyyy')),",
        "          producto = trim(regexReplace(product, '\\\\s+', ' ')),",
        "          cantidad = toInteger(toFloat(qty)),",
        "          precio_unitario = toDecimal(regexReplace(lower(unit_price),'[^0-9.]',''), 18, 2),",
        "          sucursal = 'Online',",
        "          vendedor = toString(null()),",
        "          cliente_nombre = iif(isNull(customer_name) || length(trim(customer_name))==0, toString(null()), trim(customer_name)),",
        "          cliente_email = iif(isNull(customer_email) || length(trim(customer_email))==0, toString(null()), lower(trim(customer_email))),",
        "          cliente_ciudad = iif(isNull(customer_city) || length(trim(customer_city))==0, toString(null()), trim(customer_city)),",
        "          metodo_pago = iif(isNull(payment_method) || length(trim(payment_method))==0, toString(null()), trim(payment_method)),",
        "          estado = iif(isNull(status) || length(trim(status))==0, toString(null()), trim(status)),",
        "          shipping_cost = toDecimal(regexReplace(lower(shipping_cost),'[^0-9.]',''), 18, 2),",
        "          canal = 'Online') ~> derivedColumn1",
        "derivedColumn1 sink(allowSchemaDrift: true,",
        "     validateSchema: false,",
        "     input(",
        "          id_venta as string,",
        "          fecha as date,",
        "          producto as string,",
        "          cantidad as integer,",
        "          precio_unitario as decimal(18,2),",
        "          sucursal as string,",
        "          vendedor as string,",
        "          cliente_nombre as string,",
        "          cliente_email as string,",
        "          cliente_ciudad as string,",
        "          metodo_pago as string,",
        "          estado as string,",
        "          shipping_cost as decimal(18,2),",
        "          canal as string",
        "     ),",
        "     deletable:false,",
        "     insertable:true,",
        "     updateable:false,",
        "     upsertable:false,",
        "     format: 'table',",
        "     skipDuplicateMapInputs: true,",
        "     skipDuplicateMapOutputs: true,",
        "     errorHandlingOption: 'stopOnFirstError',",
        "     mapColumn(",
        "          id_venta,",
        "          fecha,",
        "          producto,",
        "          cantidad,",
        "          precio_unitario,",
        "          sucursal,",
        "          vendedor,",
        "          cliente_nombre,",
        "          cliente_email,",
        "          cliente_ciudad,",
        "          metodo_pago,",
        "          estado,",
        "          shipping_cost,",
        "          canal",
        "     )) ~> sink1"
      ]
    }
  }
}