{
  "name": "df_silver_ventas_online",
  "properties": {
    "folder": {
      "name": "silver"
    },
    "type": "MappingDataFlow",
    "typeProperties": {
      "sources": [
        {
          "dataset": {
            "referenceName": "ds_file_ventas_online",
            "type": "DatasetReference"
          },
          "name": "source1"
        }
      ],
      "sinks": [
        {
          "dataset": {
            "referenceName": "silver_ventas_online",
            "type": "DatasetReference"
          },
          "name": "sink1"
        }
      ],
      "transformations": [
        {
          "name": "filter1"
        },
        {
          "name": "derivedColumn1"
        }
      ],
      "scriptLines": [
        "source(output(",
        "          order_id as string,",
        "          timestamp as string,",
        "          product as string,",
        "          qty as string,",
        "          unit_price as string,",
        "          customer as (name as string, email as string, city as string),",
        "          payment_method as string,",
        "          status as string,",
        "          shipping_cost as string,",
        "          channel as string",
        "     ),",
        "     allowSchemaDrift: true,",
        "     validateSchema: false,",
        "     ignoreNoFilesFound: false,",
        "     documentForm: 'arrayOfDocuments') ~> source1",
        "source1 filter(!isNull(order_id) && length(trim(order_id)) > 0) ~> filter1",
        "filter1 derive(id_venta = trim(order_id),",
        "          fecha = coalesce(toDate(toString(timestamp),'yyyy-MM-dd'), toDate(left(toString(timestamp),10),'yyyy-MM-dd'), toDate(toString(timestamp),'dd-MMM-yyyy'), toDate(toString(timestamp),'MMMM dd, yyyy'), toDate(toString(timestamp),'yyyy/MM/dd'), toDate(toString(timestamp),'dd/MM/yyyy'), toDate(replace(toString(timestamp),' de ',' '),'dd MMMM yyyy'), toDate(toString(timestamp),'MM-dd-yyyy'), toDate(toString(timestamp),'MM-dd-yyyy')),",
        "          producto = trim(regexReplace(product, '\\\\s+', ' ')),",
        "          cantidad = toInteger(toFloat(toString(qty))),",
        "          precio_unitario = toDecimal(regexReplace(lower(toString(unit_price)),'[^0-9.]',''), 18, 2),",
        "          sucursal = 'Online',",
        "          vendedor = toString(null()),",
        "          cliente_nombre = iif(isNull(customer.name) || length(trim(toString(customer.name)))==0, toString(null()), trim(toString(customer.name))),",
        "          cliente_email = iif(isNull(customer.email) || length(trim(toString(customer.email)))==0, toString(null()), lower(trim(toString(customer.email)))),",
        "          cliente_ciudad = iif(isNull(customer.city) || length(trim(toString(customer.city)))==0, toString(null()), trim(toString(customer.city))),",
        "          metodo_pago = iif(isNull(payment_method) || length(trim(toString(payment_method)))==0, toString(null()), trim(toString(payment_method))),",
        "          estado = iif(isNull(status) || length(trim(toString(status)))==0, toString(null()), trim(toString(status))),",
        "          shipping_cost = toDecimal(regexReplace(lower(toString(shipping_cost)),'[^0-9.]',''), 18, 2),",
        "          canal = 'Online') ~> derivedColumn1",
        "derivedColumn1 sink(allowSchemaDrift: true,",
        "     validateSchema: false,",
        "     input(",
        "          id_venta as string,",
        "          fecha as date,",
        "          producto as string,",
        "          cantidad as integer,",
        "          precio_unitario as decimal(18,2),",
        "          sucursal as string,",
        "          vendedor as string,",
        "          cliente_nombre as string,",
        "          cliente_email as string,",
        "          cliente_ciudad as string,",
        "          metodo_pago as string,",
        "          estado as string,",
        "          shipping_cost as decimal(18,2),",
        "          canal as string",
        "     ),",
        "     deletable:false,",
        "     insertable:true,",
        "     updateable:false,",
        "     upsertable:false,",
        "     format: 'table',",
        "     skipDuplicateMapInputs: true,",
        "     skipDuplicateMapOutputs: true,",
        "     errorHandlingOption: 'stopOnFirstError',",
        "     mapColumn(",
        "          id_venta,",
        "          fecha,",
        "          producto,",
        "          cantidad,",
        "          precio_unitario,",
        "          sucursal,",
        "          vendedor,",
        "          cliente_nombre,",
        "          cliente_email,",
        "          cliente_ciudad,",
        "          metodo_pago,",
        "          estado,",
        "          shipping_cost,",
        "          canal",
        "     )) ~> sink1"
      ]
    }
  }
}