{
  "name": "df_silver_ventas_lpz",
  "properties": {
    "folder": {
      "name": "silver"
    },
    "type": "MappingDataFlow",
    "typeProperties": {
      "sources": [
        {
          "dataset": {
            "referenceName": "ds_file_ventas_lpz",
            "type": "DatasetReference"
          },
          "name": "source1"
        }
      ],
      "sinks": [
        {
          "dataset": {
            "referenceName": "silver_ventas_lpz",
            "type": "DatasetReference"
          },
          "name": "sink1"
        }
      ],
      "transformations": [
        {
          "name": "filter1"
        },
        {
          "name": "derivedColumn1"
        }
      ],
      "scriptLines": [
        "source(output(",
        "          ID_Venta as string,",
        "          Fecha_Venta as string,",
        "          Producto as string,",
        "          Cant as string,",
        "          PrecioUnit as string,",
        "          Sucursal as string,",
        "          Vendedor as string,",
        "          NombreCliente as string,",
        "          EmailCliente as string,",
        "          MetodoPago as string",
        "     ),",
        "     allowSchemaDrift: true,",
        "     validateSchema: false,",
        "     ignoreNoFilesFound: false) ~> source1",
        "source1 filter(!isNull(ID_Venta) && length(trim(ID_Venta)) > 0) ~> filter1",
        "filter1 derive(id_venta = trim(ID_Venta),",
        "          fecha = coalesce(toDate(toString(Fecha_Venta),'yyyy-MM-dd'), toDate(left(toString(Fecha_Venta),10),'yyyy-MM-dd'), toDate(toString(Fecha_Venta),'dd-MMM-yyyy'), toDate(toString(Fecha_Venta),'MMMM dd, yyyy'), toDate(toString(Fecha_Venta),'yyyy/MM/dd'), toDate(toString(Fecha_Venta),'dd/MM/yyyy'), toDate(replace(toString(Fecha_Venta),' de ',' '),'dd MMMM yyyy'), toDate(toString(Fecha_Venta),'MM-dd-yyyy'), toDate(toString(Fecha_Venta),'MM-dd-yyyy')),",
        "          producto = trim(regexReplace(Producto, '\\\\s+', ' ')),",
        "          cantidad = toInteger(toFloat(toString(Cant))),",
        "          precio_unitario = toDecimal(regexReplace(lower(toString(PrecioUnit)),'[^0-9.]',''), 18, 2),",
        "          sucursal = 'La Paz',",
        "          vendedor = iif(isNull(Vendedor) || length(trim(toString(Vendedor)))==0, toString(null()), trim(toString(Vendedor))),",
        "          cliente_nombre = trim(NombreCliente),",
        "          cliente_email = iif(isNull(EmailCliente) || length(trim(toString(EmailCliente)))==0, toString(null()), lower(trim(toString(EmailCliente)))),",
        "          cliente_ciudad = toString(null()),",
        "          metodo_pago = iif(isNull(MetodoPago) || length(trim(toString(MetodoPago)))==0, toString(null()), trim(toString(MetodoPago))),",
        "          estado = toString(null()),",
        "          shipping_cost = toDecimal(0, 18, 2),",
        "          canal = 'LPZ') ~> derivedColumn1",
        "derivedColumn1 sink(allowSchemaDrift: true,",
        "     validateSchema: false,",
        "     input(",
        "          id_venta as string,",
        "          fecha as date,",
        "          producto as string,",
        "          cantidad as integer,",
        "          precio_unitario as decimal(18,2),",
        "          sucursal as string,",
        "          vendedor as string,",
        "          cliente_nombre as string,",
        "          cliente_email as string,",
        "          cliente_ciudad as string,",
        "          metodo_pago as string,",
        "          estado as string,",
        "          shipping_cost as decimal(18,2),",
        "          canal as string",
        "     ),",
        "     deletable:false,",
        "     insertable:true,",
        "     updateable:false,",
        "     upsertable:false,",
        "     format: 'table',",
        "     skipDuplicateMapInputs: true,",
        "     skipDuplicateMapOutputs: true,",
        "     errorHandlingOption: 'stopOnFirstError',",
        "     mapColumn(",
        "          id_venta,",
        "          fecha,",
        "          producto,",
        "          cantidad,",
        "          precio_unitario,",
        "          sucursal,",
        "          vendedor,",
        "          cliente_nombre,",
        "          cliente_email,",
        "          cliente_ciudad,",
        "          metodo_pago,",
        "          estado,",
        "          shipping_cost,",
        "          canal",
        "     )) ~> sink1"
      ]
    }
  }
}